{
  "name": "nishi-dsh-codex-usage-source",
  "version": "0.1.0-rc.1",
  "description": "Official Codex app-server rate-limits source adapter for Nishi DSH Suite",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/codex-usage-source"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": { "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@openai/codex": "0.147.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  },
  "license": "MIT"
}
