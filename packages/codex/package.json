{
  "name": "nishi-dsh-codex",
  "description": "Managed Codex primary/subagent integration for DeepSeek Harness",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./web-search-backend": { "types": "./lib/web-search-backend.d.ts", "default": "./lib/web-search-backend.js" },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/codex"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": { "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues" },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live:primary": "tsx --test test-live/primary-live.test.ts",
    "test:live:web-search": "tsx --test test-live/web-search.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@openai/codex": "0.147.0",
    "@openai/codex-sdk": "0.147.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  },
  "license": "MIT"
}
