{
  "name": "nishi-dsh-suite",
  "version": "0.1.0-rc.2",
  "description": "Nishi DSH Suite bundle for DeepSeek Harness Market",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "nishi-dsh-suite": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/orchestrator/preset.yml": "./presets/orchestrator/preset.yml",
    "./presets/orchestrator/agent.cordis.yml": "./presets/orchestrator/agent.cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "presets/**/*.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/suite"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": {
    "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "pack": "npm pack"
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "0.1.1-rc.2",
    "nishi-dsh-provider-kit": "workspace:0.1.0-rc.2",
    "nishi-dsh-codex": "workspace:0.1.0-rc.2",
    "nishi-dsh-antigravity": "workspace:0.1.0-rc.2",
    "nishi-dsh-claude-usage-source": "workspace:0.1.0-rc.2",
    "nishi-dsh-primary-web-search": "workspace:0.1.0-rc.2",
    "nishi-dsh-project-memory": "workspace:0.1.0-rc.2",
    "nishi-dsh-usage-limits": "workspace:0.1.0-rc.2",
    "nishi-dsh-usage-limits-host": "workspace:0.1.0-rc.2",
    "nishi-dsh-codex-usage-source": "workspace:0.1.0-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
