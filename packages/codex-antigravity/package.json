{
  "name": "nishi-dsh-codex-antigravity",
  "description": "Managed Codex and Antigravity subagents plus official local-runtime primary provider bridges for DeepSeek Harness",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./primary-web-search": {
      "types": "./lib/primary-web-search/index.d.ts",
      "default": "./lib/primary-web-search/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/codex-antigravity"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": {
    "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live:antigravity": "tsx --test test-live/antigravity-primary.test.ts",
    "test:live:antigravity-subagent": "tsx --test test-live/antigravity-subagent.test.ts",
    "test:live:web-search-codex": "tsx --test test-live/primary-web-search-codex.test.ts",
    "test:live:web-search-antigravity": "tsx --test test-live/primary-web-search-antigravity.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@openai/codex": "0.147.0",
    "@openai/codex-sdk": "0.147.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2",
    "yaml": "2.9.0"
  },
  "license": "MIT"
}
