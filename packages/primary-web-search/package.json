{
  "name": "nishi-dsh-primary-web-search",
  "description": "Primary-model-routed web_search tool for Nishi DSH Suite",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/primary-web-search"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": { "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues" },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live:codex": "tsx --test test-live/codex.test.ts",
    "test:live:antigravity": "tsx --test test-live/antigravity.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "nishi-dsh-codex": "workspace:0.1.0-rc.1",
    "nishi-dsh-antigravity": "workspace:0.1.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  },
  "license": "MIT"
}
