{
  "name": "nishi-dsh-claude",
  "version": "0.1.0-rc.3",
  "description": "Claude usage-only provider plugin for Nishi DSH Suite, reading limits through the installed official Claude CLI",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git",
    "directory": "packages/claude"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": { "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "nishi-dsh-core": "workspace:0.1.0-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.2"
  },
  "license": "MIT"
}
