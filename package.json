{
  "name": "nishi-dsh-suite-workspace",
  "description": "Public modular DSH Market distribution for Nishi DSH Suite",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NishiMihaeru/nishi-dsh-suite.git"
  },
  "homepage": "https://github.com/NishiMihaeru/nishi-dsh-suite#readme",
  "bugs": {
    "url": "https://github.com/NishiMihaeru/nishi-dsh-suite/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm -r --if-present test",
    "test:orchestrator": "node scripts/validate-orchestrator.mjs",
    "verify:package-contracts": "node scripts/verify-package-contracts.mjs",
    "verify:release-family": "node scripts/verify-release-family.mjs",
    "verify:local": "pnpm verify:release-family && pnpm verify:package-contracts && pnpm test:orchestrator && pnpm build && pnpm check && pnpm test && pnpm pack:local",
    "check:npm-names": "node scripts/check-npm-names.mjs --require-available",
    "pack:packages": "pnpm -r --if-present pack",
    "pack:local": "node scripts/pack-local.mjs",
    "verify:bundle-install": "node scripts/verify-bundle-install.mjs"
  }
}
